    {
      "parameters": {
        "jsCode": "// Build the API response: latest N rows sorted by timestamp desc.\nconst N = 50;\n\n// Drop empty-json items (alwaysOutputData emits one {} item when the sheet is empty).\nconst rows = $input.all()\n  .map((i) => i.json)\n  .filter((r) => r && Object.keys(r).length > 0);\n\nconst shaped = rows.map((r) => ({\n  timestamp: r.timestamp ?? null,\n  source_url: r.source_url ?? null,\n  field_name: r.field_name ?? null,\n  value: r.value ?? null,\n  ai_summary: r.ai_summary ?? null,\n  status: r.status ?? null,\n}));\n\n// Sort by timestamp descending (ISO strings sort lexicographically).\nshaped.sort((a, b) => {\n  const ta = a.timestamp || '';\n  const tb = b.timestamp || '';\n  if (ta < tb) return 1;\n  if (ta > tb) return -1;\n  return 0;\n});\n\nconst latest = shaped.slice(0, N);\n\n// Return a single item carrying the array so the Respond node can output it as JSON.\nreturn [{ json: { rows: latest } }];"
      },
