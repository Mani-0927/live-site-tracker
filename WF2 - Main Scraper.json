    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Clean the extracted value, coerce numerics, dedup vs last stored row, decide outcome + alert.\nconst cfg = $('Loop Over URLs').item.json;\nconst url = cfg.url;\nconst field_name = cfg.field_name;\nconst thresholdRaw = cfg.threshold;\n\n// Current extracted value.\nconst extractItem = $('Extract Value').item ? $('Extract Value').item.json : {};\nconst rawValue = (extractItem && extractItem.value != null) ? extractItem.value : '';\n\n// Detect fetch failure (continueRegularOutput passes an error item through).\nconst httpItem = $('Fetch Page').item ? $('Fetch Page').item.json : {};\nconst httpError = httpItem && (httpItem.error !== undefined && httpItem.error !== null);\n\n// Clean text: trim + collapse whitespace.\nconst clean = String(rawValue).replace(/\\s+/g, ' ').trim();\n\n// Numeric coercion (strip currency symbols / commas).\nconst numParsed = parseFloat(clean.replace(/[^0-9.\\-]/g, ''));\nconst isNumeric = clean !== '' && !isNaN(numParsed) && /[0-9]/.test(clean);\nlet value = isNumeric ? numParsed : clean;\n// Agar value array hai (jaise multiple tags), to comma-space se joḍ do\nif (Array.isArray(value)) {\n  value = value.map(v => String(v).trim()).filter(v => v.length > 0).join(', ');\n}\n\n// Threshold parsing.\nconst hasThreshold = thresholdRaw !== undefined && thresholdRaw !== null && String(thresholdRaw).trim() !== '';\nconst threshold = hasThreshold ? parseFloat(String(thresholdRaw).replace(/[^0-9.\\-]/g, '')) : null;\n\n// Previous stored value for this source_url (last by timestamp).\nconst prevRows = $('Read Last Data Row').all()\n  .map((i) => i.json)\n  .filter((r) => r && Object.keys(r).length > 0 && String(r.source_url) === String(url));\nprevRows.sort((a, b) => ((a.timestamp || '') < (b.timestamp || '') ? 1 : -1));\nconst prev = prevRows.length ? prevRows[0] : null;\nconst oldValueRaw = prev ? prev.value : null;\n\nlet oldValue = oldValueRaw;\nif (isNumeric && oldValueRaw != null) {\n  const on = parseFloat(String(oldValueRaw).replace(/[^0-9.\\-]/g, ''));\n  if (!isNaN(on)) oldValue = on;\n}\n\n// Status.\nlet status = 'ok';\nif (httpError) status = 'error';\nelse if (clean === '') status = 'empty';\n\n// Changed?\nlet changed;\nif (oldValueRaw === null || oldValueRaw === undefined) changed = true;\nelse changed = String(oldValue) !== String(value);\n\n// Outcome.\nlet outcome;\nif (status !== 'ok') outcome = 'log_only';\nelse if (!changed) outcome = 'skip';\nelse outcome = 'changed';\n\n// Alert decision (only for real changes).\nlet shouldAlert = false;\nlet direction = 'changed';\nif (outcome === 'changed') {\n  if (isNumeric && hasThreshold) {\n    if (oldValueRaw === null || oldValueRaw === undefined) {\n      shouldAlert = value >= threshold;\n      direction = value >= threshold ? 'crossed up' : 'below';\n    } else {\n      const oldSide = oldValue >= threshold;\n      const newSide = value >= threshold;\n      if (oldSide !== newSide) {\n        shouldAlert = true;\n        direction = newSide ? 'crossed up' : 'crossed down';\n      }\n    }\n  } else if (isNumeric && !hasThreshold) {\n    shouldAlert = true;\n    if (oldValueRaw === null || oldValueRaw === undefined) direction = 'new';\n    else direction = value > oldValue ? 'up' : (value < oldValue ? 'down' : 'changed');\n  } else {\n    shouldAlert = true;\n    direction = 'changed';\n  }\n}\n\nconst timestamp = new Date().toISOString();\n\nreturn {\n  json: {\n    timestamp,\n    source_url: url,\n    field_name: field_name,\n    value: value,\n    old_value: oldValueRaw,\n    threshold: threshold,\n    direction: direction,\n    status: status,\n    changed: changed,\n    outcome: outcome,\n    shouldAlert: shouldAlert,\n    ai_summary: '',\n  },\n};"
      },
