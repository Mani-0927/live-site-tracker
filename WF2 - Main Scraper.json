      "id": "bdcff6eb-798b-479e-b6d4-d8f519493fec",
      "name": "Read Last Data Row",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [
        1344,
        176
      ],
      "alwaysOutputData": true,
